{
  "name": "servivo",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/web-admin",
    "packages/types",
    "packages/firebase",
    "packages/scheduling",
    "packages/ui",
    "packages/api-client",
    "packages/shared-types",
    "packages/utils"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "web": "turbo run dev --filter=@servivo/web",
    "mobile": "cd apps/mobile && npx expo start"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=18.0.0"
  }
}
