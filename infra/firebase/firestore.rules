rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read any profile (needed for chat participant lookups)
      allow read: if request.auth != null;

      // Only the owner can write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Consumer or pro on the booking can read it
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.consumerId ||
         request.auth.uid == resource.data.proId);

      // Consumer can create a booking (must set themselves as consumerId)
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.consumerId;

      // Consumer can cancel; pro can accept/reject/complete
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.consumerId ||
         request.auth.uid == resource.data.proId);

      allow delete: if false;
    }

    // ─── Availability slots ───────────────────────────────────────────────────
    match /availability/{slotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == request.resource.data.proId;
    }

    // ─── Conversations ────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      // Only participants can read an existing conversation
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;

      // Either participant can create — check the incoming data, not the (non-existent) existing doc
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds;

      // Participants can update (e.g. lastMessage / lastAt)
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;

      allow delete: if false;

      // ─── Messages subcollection ───────────────────────────────────────────
      match /messages/{messageId} {
        // Any signed-in user can read messages (conversation ID is private by design)
        allow read: if request.auth != null;

        // Only the sender can create a message as themselves — no get() on parent needed
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.senderId;

        allow update, delete: if false;
      }
    }
  }
}
